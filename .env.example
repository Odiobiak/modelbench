# ─────────────────────────────────────────────────────────────
#  modelbench credentials.  Copy to .env  ( .env is gitignored )
# ─────────────────────────────────────────────────────────────

# PRIMARY GATEWAY --------------------------------------------------
# One key, hundreds of models. This is the only key you strictly need
# for the CLI/engine (bench/*). Skip everything else below to start.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# API LAYER (api/) --------------------------------------------------
# Only needed if you're running the FastAPI backend + web frontend
# instead of (or in addition to) the bare CLI. The model registry,
# settings and run index live in Postgres; run results themselves
# still land in results/*.parquet regardless.
#
# Supabase (Settings > API in your project dashboard), or point
# DATABASE_URL/DIRECT_URL at any Postgres instance you already run.
SUPABASE_URL=
# Use the service_role key server-side only -- never ship it to a mobile/web client.
SUPABASE_SERVICE_KEY=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# OPTIONAL DIRECT PROVIDERS ----------------------------------------
# Only needed when you must hit a vendor first-party, e.g. an Azure
# deployment pinned to a region, or a private/self-hosted endpoint.
# Everything else should go through OpenRouter.
OPENAI_API_KEY=
OPENAI_BASE=https://api.openai.com/v1

# Anthropic authenticates with x-api-key, not a bearer token, and its own
# /v1/messages endpoint -- route: anthropic in config/models.yaml speaks
# this natively. No _BASE var needed, there's only one Anthropic API.
ANTHROPIC_API_KEY=

GEMINI_API_KEY=
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/openai

DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com

MISTRAL_API_KEY=
GROQ_API_KEY=

# Azure needs base + key + api-version (regional latency testing)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-10-21

# Any OpenAI-compatible endpoint (vLLM, LiteLLM, Cognigy-facing proxy...)
CUSTOM_OPENAI_BASE=
CUSTOM_OPENAI_API_KEY=

# Amazon Bedrock -- route: bedrock. Not OpenAI-compatible at all (AWS
# SigV4-signed requests via boto3, the Converse API, its own request/
# response shape), so it needs a region + two credential parts instead of
# one bearer token. AWS_SESSION_TOKEN is optional -- only needed for
# temporary/assumed-role credentials, leave blank for a long-lived IAM user.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# OPTIONAL OBSERVABILITY -------------------------------------------
# Leave blank to skip. Results always land in results/*.parquet regardless.
# Free "Hobby" tier at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# SAFETY RAILS -----------------------------------------------------
# Hard ceiling in USD. The run aborts if projected or actual spend exceeds it.
BENCH_MAX_SPEND_USD=5.00
